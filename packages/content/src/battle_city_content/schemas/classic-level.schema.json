{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duckycodess/battle-city-reimagined/blob/main/packages/content/src/battle_city_content/schemas/classic-level.schema.json",
  "title": "Battle City Reimagined classic level",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "source", "grid", "spawns"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path"],
      "properties": {
        "repository": {
          "const": "https://github.com/duckycodess/Battle-City"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "const": "assets/stage.py"
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "rows"],
      "properties": {
        "width": {
          "const": 16
        },
        "height": {
          "const": 16
        },
        "rows": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[0-8]{16}$"
          }
        }
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["players", "enemies"],
      "properties": {
        "players": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/playerSpawn"
          }
        },
        "enemies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/spawn"
          }
        }
      }
    }
  },
  "$defs": {
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "playerSpawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "slot"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "slot": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
